# ================================================================
#  LOOM — « CLAVIERS » : le zoo des petits claviers/synthés.
#  Chaque ligne = UNE famille de synthèse, tous sur la même prog.
#  > RUN. Isole-les un par un avec les boutons M (mute) / S (solo)
#    de la grille, ou en plein écran : scene + touche C pour le code.
#  > Change la prog (ex. Dm Bb F C) : tout suit l'harmonie via ^N.
# ================================================================

title: Claviers
bpm:   96
key:   a minor
tune:  just            # juste intonation : ratios purs, plus consonant
prog:  Am F C G        # un accord par mesure (le token ^ suit)
warmth: 0.4            # saturation chaleur du master (worklet)
scene: harmono
film:  vertical

# ---------- FONDATIONS ----------
kick:  x . . . x . . . x . . . x . . . | sample bd | gain 0.5 | comp 0.4
hat:   . . x . . . x . . . x . . . x . | sample hh | gain 0.1 | swing 56 | degrade 20
bass:  ^1 . . . 5, . ^1 . ^1 . . . 6, . ^1 . | saw | oct 2 | sub 0.6 | fold 0.25 | lp 700 | slide | comp 0.4 | gate 0.4 | gain 0.13 | hue 30

# ---------- LES CLAVIERS (un timbre par ligne, même accord ^) ----------
# 1) e-piano FM (Chowning) — le Rhodes
epiano: ^1 ^2 ^3 ^2 ^3 ^1' ^2 ^3 | sine | fm 1 2 | env 0.005 0.3 0.4 0.4 | reverb 0.4 | gate 0.6 | gain 0.1 | hue 200

# 2) orgue à table d'ondes (additif)
orgue:  ^ . . . ^ . . . ^ . . . ^ . . . | wt organ | lp 2400 | env 0.02 0.1 0.9 0.2 | reverb 0.3 | gain 0.07 | hue 50

# 3) harpe Karplus-Strong (corde pincée, Stanford)
harpe:  ^1 ^2 ^3 ^1' ^2 ^3 ^2 ^1 | pluck 0.75 | strum 0.01 | delay 0.3 | reverb 0.5 | gate 0.6 | gain 0.11 | hue 40

# 4) cordes frottées (bow) — guide d'onde soutenu
cordes: ^ . . . . . . . . . . . . . . . | bow | unison 2 | lp 1900 | reverb 0.7 | gate 1.7 | gain 0.08 | hue 280

# 5) clarinette (reed) — réflexion inversée, harmoniques impaires
anche:  . . ^1' . . . ^3 . . . ^2 . . . ^1 . | reed | lp 2200 | reverb 0.4 | delay 0.25 | gate 0.6 | gain 0.09 | hue 150

# 6) cloches modales (partiels inharmoniques)
cloche: . . . . ^1' . . . . . . . ^3' . . . | bell | reverb 0.6 | delay 0.4 | degrade 25 | gain 0.09 | pan -0.3 | hue 60

# 7) chœur à formants (IRCAM CHANT) + phaser
choeur: ^ . . . . . . . . . . . . . . . | saw | unison 4 | vowel a | phaser 0.4 | lp 2000 | reverb 0.7 | gate 1.6 | gain 0.07 | hue 320

# 8) lead PWM (largeur d'impulsion analogique)
pwmkey: ^1 . ^3 . ^2 . ^1' . | pwm 0.6 | lp 2200 | fenv 0.4 | delay 0.3 | gate 0.5 | gain 0.07 | hue 0

# 9) nappe granulaire (Roads/IRCAM)
nuage:  ^1 . . . . . . . | sine | grain 0.6 | reverb 0.7 | gate 2 | gain 0.06 | pan 0.3 | hue 220

# 10) supersaw (unison large)
saws:   ^ . . . . . . . | saw | supersaw | lp 1600 | env 0.4 0.3 0.7 1.5 | reverb 0.5 | gate 1.5 | gain 0.05 | stereo 1.5 | hue 260

# ----------------------------------------------------------------
#  Astuce : clique S sur une voix pour l'isoler, M pour la couper.
#  Essaie aussi : tune: 19edo · key: d bayati (maqam) · | wt warm
# ----------------------------------------------------------------
