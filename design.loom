# ================================================================
#  LOOM — « DESIGN » : le zoo du SOUND DESIGN.
#  Une voix = une technique de synthèse/traitement encore non mise
#  en avant : tables d'ondes (wt) · vocodeur · hard-sync · ring/AM ·
#  wavefolding · filtre passe-bande (wah) · bruit+octave.
#
#  Tout suit la même harmonie (^). RUN, puis SOLO (S) chaque ligne
#  pour entendre une seule synthèse à la fois.
# ================================================================

title:  DESIGN
bpm:    104
key:    d minor
prog:   Dm Bb F C          # le token ^ suit cette harmonie
tune:   just
duck:   30
warmth: 0.4
scene:  cymatic
film:   vertical

# ---------- GROOVE LÉGER ----------
kick:   x . . . x . . . x . . . x . . . | sample bd | gain 0.5 | comp 0.4
hat:    . . x . . . x . . . x . . . x . | sample hh | gain 0.1 | swing 56 | degrade 18
bass:   ^1 . . . 5, . ^1 . ^1 . . . 6, . ^1 . | sine | oct 2 | sub 0.5 | env 0.005 0.09 0.3 0.07 | gain 0.16 | hue 30

# ---------- TABLES D'ONDES (wt) ----------
# orgue (table additive, riche)
wtorg:  ^ . . . ^ . . . ^ . . . ^ . . . | wt organ | lp 2400 | env 0.02 0.1 0.9 0.2 | reverb 0.3 | gain 0.07 | hue 50
# claviers chauds
wtwarm: ^1 ^2 ^3 ^2 ^3 ^1' ^2 ^3 | wt warm | env 0.005 0.2 0.5 0.4 | reverb 0.4 | gate 0.6 | gain 0.08 | hue 200
# lead « riche » + brillance octave (double)
wtrich: ^1' . ^3 . ^2 . ^1 . | wt rich | double 0.4 | lp 3000 | delay 0.3 | gate 0.5 | gain 0.07 | hue 280

# ---------- MODULATIONS ----------
# VOCODEUR : la nappe « parle » avec le sample vox
vocode: ^ . . . . . . . | saw | unison 3 | vocode vox | lp 2200 | reverb 0.5 | gate 1.6 | gain 0.08 | hue 150
# HARD-SYNC : lead qui balaye (agressif, rave/acid) + enveloppe de filtre
sync:   ^1 . ^1' . ^5 . ^3 . | sync 3 | fenv 0.6 | lp 2400 q 5 | delay 0.25 | gate 0.5 | gain 0.06 | hue 0 | mute
# RING MOD : timbre métallique inharmonique
ring:   ^1 . . . ^3 . . . | saw | ring 140 | lp 1800 | reverb 0.4 | gate 0.5 | gain 0.06 | hue 320 | mute
# AM (trémolo audio) : plus doux que ring, bandes latérales
am:     ^ . . . . . . . | tri | am 70 | lp 2000 | reverb 0.4 | gate 1.4 | gain 0.07 | hue 180 | mute

# ---------- FORMES D'ONDE ----------
# WAVEFOLDING (West-coast) : harmoniques mouvants
fold:   ^1 . ^3 . ^5 . ^3 . | tri | fold 0..0.8 | over 8 | lp 1600 | gate 0.5 | gain 0.06 | hue 60 | mute
# PASSE-BANDE balayé = WAH (filtre bp + lfo)
wah:    ^1 ^1 ^1 ^1 ^1 ^1 ^1 ^1 | saw | bp 800 q 7 | lfo cutoff 0.5 0.8 | gain 0.06 | hue 100 | mute
# BRUIT filtré + octave : souffle/air (texture, pas de hauteur nette)
air:    ^ . . . . . . . | sine | noise 0.4 | double 0.5 | hp 400 | reverb 0.6 | gate 1.8 | gain 0.05 | hue 220 | mute

# ----------------------------------------------------------------
#  Au départ : wt + vocode jouent. SOLO (S) sync/ring/am/fold/wah/air.
#  Essaie : | wt soft · | vocode breath · | ring 200 · | am 110
# ----------------------------------------------------------------
