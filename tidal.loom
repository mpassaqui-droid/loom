# ================================================================
#  LOOM : les verbes venus de Tidal / Strudel, en action.
#    | ply N      chaque coup répété N fois dans son pas
#    | linger F   boucle la première fraction F de la mesure
#    | segment N  rééchantillonne la ligne en N pas
#    | range A B  recadre les degrés du motif sur A..B
#    | loopAt N   le sample étiré (warp) sur N mesures
# ================================================================

title:  Tidal
key:    d dorian
bpm:    96
seed:   5

kick:   x . . . x . . . x . . . x . x .
hat:    x . x . x . x . | every 4 ply 3 | gain 0.08
break:  x . . . . . . . . . . . . . . . | sample amen | loopAt 2 | gain 0.22
lead:   1 2 3 5 6 5 3 2 | every 2 linger 0.25 | pluck | gain 0.1
arp:    1 3 5 | segment 8 | range 1 1'' | saw | lp 1400 | gain 0.07
bass:   walk(8) | range 1 5 | oct 2 | sine | gain 0.2
