# ================================================================
#  LOOM — « MIXTAPE » : LA SUITE. Tout, en un seul morceau.
#  Un voyage continu qui traverse les 5 vitrines, section par section,
#  toutes dans la MÊME tonalité (Am) pour que ça coule sans couture :
#
#    intro  -> ouverture (nappe granulaire + cloches)
#    keys   -> CLAVIERS  (e-piano FM, harpe, orgue à table d'ondes)
#    low    -> BASSES    (acid 303 + sub + drums)
#    design -> DESIGN    (table d'ondes, vocodeur, hard-sync)
#    glitch -> EXPOSE    (IDM : euclide, automate, break amen, aléatoire)
#    phase  -> AUTECHRE  (polymétrie/déphasage poly 13/16/17)
#    outro  -> retour au calme (nappe + cloches)
#
#  > RUN et laisse jouer du début à la fin : la console montre la
#    section en cours. Chaque voix CHANGE de visage selon la section.
#  > Mets-le en plein écran (scene) et FILME-le (film: square).
# ================================================================

title:  MIXTAPE
seed:   24
bpm:    136
key:    a minor
prog:   Am F C G           # toute la suite suit cette harmonie (^)
tune:   just
duck:   34
warmth: 0.45
feel:   18
scene:  harmono
film:   square
song:   intro*2 keys*4 low*4 design*4 glitch*4 phase*4 outro*2

# ============ BATTERIE (change selon la section) ============
kick:        x . . . x . . . x . . . x . . . | sample bd | gain 0.5 | comp 0.5 | in low design glitch outro
kick@glitch: e(7,16,2) | sample bd | gain 0.52 | comp 0.5 | drive 0.2
snare:       . . . . x! . . . . . . . x . x*3 . | sample sd | gain 0.4 | shift 0.01 | in design glitch
hat:         . . x . . . x . . . x . . . x . | sample hh | gain 0.1 | swing 56 | degrade 15 | in keys low design outro
hat@glitch:  ca(90,16) | sample hh | gain 0.11 | stereo 1.4 | pan 0.2
hat@phase:   ca(110,16) | sample hh | gain 0.1 | orbit 0.25 | degrade 15
break@glitch: {1 2} . [3 3] . 1 . {2 4}*2 . | sample amen | gain 0.28 | redux 6 | chunk 4 rev | crush 4

# ============ BASSE (sine douce -> acid -> polymétrie) ============
bass:        ^1 . . . 5, . ^1 . ^1 . . . 6, . ^1 . | sine | oct 2 | sub 0.5 | env 0.005 0.09 0.3 0.07 | gain 0.16 | hue 30 | in low design outro
bass@low:    e(7,16) ; 1 . . . . . 5, . . . . . 4, . . . | saw | oct 2 | slide | lp 480 q 9 | fenv 0.7 | drive 0.4 | gate 0.4 | gain 0.15 | hue 0
bass@glitch: e(7,16) | saw | oct 2 | slide | lp 520 q 8 | fenv 0.6 | drive 0.4 | gate 0.4 | every 4 rev | gain 0.14 | hue 0
bass@phase:  1 . 5, . 1 . 3 . 4, . | poly 11 | saw | oct 2 | lp 700 q 6 | drive 0.3 | gate 0.5 | gain 0.13 | hue 30
sub:         1 . . . . . 5, . . . 1 . . . 6, . | sine | oct 1 | sub 0.5 | env 0.005 0.1 0.3 0.07 | gain 0.28 | in low glitch phase outro

# ============ CLAVIERS (section keys) ============
keys:        ^1 ^2 ^3 ^2 ^3 ^1' ^2 ^3 | sine | fm 1 2 | env 0.005 0.3 0.4 0.4 | reverb 0.4 | gate 0.6 | gain 0.1 | hue 200 | in intro keys outro
harp@keys:   ^1 ^2 ^3 ^1' ^2 ^3 ^2 ^1 | pluck 0.75 | strum 0.01 | delay 0.3 | reverb 0.5 | gate 0.6 | gain 0.1 | hue 40
wt:          ^ . . . ^ . . . ^ . . . ^ . . . | wt organ | lp 2400 | env 0.02 0.1 0.9 0.2 | reverb 0.3 | gain 0.06 | hue 50 | in keys design phase

# ============ DESIGN (section design) ============
lead@design:   ^1' . ^3 . ^2 . ^1 . | wt rich | double 0.4 | lp 3000 | delay 0.3 | gate 0.5 | gain 0.07 | hue 280
vocode@design: ^ . . . . . . . | saw | unison 3 | vocode vox | lp 2200 | reverb 0.5 | gate 1.6 | gain 0.08 | hue 150
sync@design:   ^1 . ^1' . ^5 . ^3 . | sync 3 | fenv 0.6 | lp 2400 q 5 | delay 0.25 | gate 0.5 | gain 0.06 | hue 0

# ============ EXPOSE / IDM (section glitch) ============
lead@glitch: {1 3 5} . <5/7> . {3 5 1'} . 6? . | sine | fm 1 2 | lp 2600 | jux rev | delay 0.34 | reverb 0.4 | gate 0.6 | semi 12 | gain 0.1 | hue 200
arp@glitch:  ^ . ^ . ^ . ^ . | arp updown | pluck 0.7 | chunk 4 rev | flange 0.3 | delay 0.25 | reverb 0.3 | gate 0.5 | gain 0.09 | hue 40

# ============ AUTECHRE / phasing (section phase) ============
ph1@phase: 1 5 4 3 5 6 1' 3 | poly 13 | pluck 0.7 | reverb 0.6 | gate 0.6 | gain 0.1 | pan -0.4 | hue 190
ph2@phase: 1 5 4 3 5 6 1' 3 | poly 16 | pluck 0.7 | reverb 0.6 | gate 0.6 | gain 0.1 | hue 250
ph3@phase: 1 5 4 3 5 6 1' 3 | poly 17 | pluck 0.7 | reverb 0.6 | gate 0.6 | gain 0.1 | pan 0.4 | hue 320

# ============ NAPPE + CLOCHES (du début à la fin) ============
pad:   ^ . . . . . . . . . . . . . . . | saw | unison 4 | grain 0.4 | vowel a | lp 1500 | flange 0.2 | lfo cutoff 0.15 0.5 | reverb 0.7 | gate 1.8 | gain 0.06 | hue 300 | in intro keys design glitch phase outro
bell:  ^1' . . . . . . . . . . . ^3' . . . | bell | off 5 add 2 | reverb 0.6 | delay 0.4 | degrade 30 | gain 0.07 | pan 0.4 | hue 60 | in intro keys phase outro

# ----------------------------------------------------------------
#  Le morceau dure 24 mesures et raconte toute la langue LOOM.
#  Change seed: 25 -> autre version. prog: Am Em F C -> autre couleur.
#  FILME-le : bouton FILM (format carré), il a déjà un carton-titre.
# ----------------------------------------------------------------
