# TECHNO — un morceau complet. Colle dans LOOM, clique RUN.
# (RENDER exporte le morceau entier en WAV.)
seed:  8
duck:  68
key:   a minor
song:  intro*8 build*8 drop*16 break*8 drop*16 peak*16 outro*8

# KICK — four-on-the-floor (s'efface au break)
kick:        x . . . x . . . x . . . x . . . | sample bd
kick@intro:  x . . . . . . . x . . . . . . . | sample bd
kick@break:  . . . . . . . . . . . . . . . .

# CLAP — sur le 2 et le 4, plus dense au peak
clap:        . . . . x . . . . . . . x . . . | sample cp | gain 0.4 | in build drop peak outro
clap@peak:   . . . . x . . x . . . . x . . x | sample cp | gain 0.4

# HATS — euclidien qui s'ouvre, open hat sur le drop
hat:         e(9,16) | sample hh | gain 0.2 | pan 0.2 | in build drop break peak outro
hat@peak:    e(13,16) | sample hh | gain 0.2 | pan 0.2
oh:          . . x . . . x . . . x . . . x . | sample oh | gain 0.16 | in drop peak

# BASS — reese filtrée, plus agressive au peak
bass:        . 1 . 1 . 1 . 1 . 1 . 1 . 1 . 1 | saw | unison 3 | detune 16 | lp 520 q 6 | drive 0.3 | env 0.005 0.06 0.35 0.08 | oct 2 | gain 0.22 | in build drop peak outro
bass@peak:   . 1 . 1 . 1 5, . . 1 . 1 . 7, 1 . | saw | unison 3 | detune 18 | lp 760 q 7 | drive 0.45 | env 0.005 0.06 0.35 0.08 | oct 2 | gain 0.22

# STAB — accords courts
stab@drop:   . . . . . . Am . . . . . . . . . | saw | unison 3 | lp 1500 q 6 | env 0.01 0.1 0.2 0.2 | gain 0.12 | reverb 0.3
stab@peak:   . . Am . . . F . . . Am . . . G . | saw | unison 3 | lp 2000 q 6 | env 0.01 0.1 0.2 0.2 | gain 0.13 | reverb 0.3

# ACID — riff dont le filtre s'ouvre sur la build (automation), arpège au peak
acid@build:  1 1 1' 1 5 1 1' 5 | saw | unison 3 | lp 300..5000 | over 8 | q 8 | drive 0.4 | env 0.01 0.08 0.3 0.1 | gain 0.13
acid@peak:   1 1' 5 1' 3 1' 4 1' | sample arpy | gain 0.3 | delay 0.3 | pan -0.2

# PAD — atmosphère (intro / break / outro)
pad:         Am7 . . . . . . . | saw | unison 4 | lp 820 | env 0.8 0.5 0.7 2 | reverb 0.5 | gain 0.13 | in intro break outro
