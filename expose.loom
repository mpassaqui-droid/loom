# ================================================================
#  LOOM — « EXPOSÉ » : un set IDM qui montre PRESQUE TOUTE la langue.
#  (Aphex / Autechre / Squarepusher — mais surtout une démo vivante.)
#
#  Techniques exposées, ligne par ligne :
#   euclidien e(k,n,rot) · automates ca(rule,n) · morse(n) · ratchets/rolls *N >/<
#   probabilité ?N · aléatoire {} · alternance <a/b> · sous-séquences [] · stacks ;
#   accents ! · verbes rev/every/jux/chunk/off/add/semi/fast · overrides voix@section
#   accord-suivi ^ · granulaire · formants · microtonal (tune) · sidechain (duck)
#   FX worklet : redux · reson · flange · stereo · + crush/drive/fold/lfo/slide/fenv.
#
#  > RUN. La console affiche la STRUCTURE (song). Les ca()/{} ÉVOLUENT
#    à chaque mesure ; seed les rend reproductibles. seed: 24 -> 25 = variation.
#  > SOLO (S) une voix pour entendre une seule technique.
# ================================================================

title:  EXPOSE
seed:   24                 # rend tout l'aléatoire reproductible
bpm:    152
key:    e minor
prog:   Em C G B           # le token ^ suit cette harmonie, mesure par mesure
tune:   just               # microtonal : intonation juste (ratios purs)
duck:   38                 # sidechain : le mix pompe sur le kick
warmth: 0.45               # saturation chaleur (worklet)
feel:   20                 # micro-humanisation du timing
scene:  clifford
film:   square
song:   intro*2 build*4 beat*8 break*4 drop*8 melt*4 outro*2

# ---------- BATTERIE GLITCH ----------
# kick écrit + ROLL crescendo (x*4>) ; verbe every : fill une mesure sur 8
kick:   x . . x . . x . x . . . x . x*4> . | sample bd | gain 0.55 | comp 0.5 | every 8 fast 2 | in build beat break drop melt outro
# override @drop : motif EUCLIDIEN tournant (7 frappes sur 16, rotation 2)
kick@drop: e(7,16,2) | sample bd | gain 0.55 | comp 0.5 | drive 0.2

# snare backbeat : accent ! + fantôme PROBABILISTE (?40) + RATCHET *3 en fin de mesure
snare:  . . . . x! . . x?40 . . . . x . x*3 . | sample sd | gain 0.42 | shift 0.01 | in beat break drop melt outro

# charley via AUTOMATE de Wolfram (règle 90 = Sierpinski) — évolue seul + swing + STEREO (worklet)
hat:    ca(90,16) | sample hh | gain 0.12 | swing 58 | degrade 18 | stereo 1.4 | pan 0.2 | in build beat break drop melt outro
# perc chaotique (règle 30) + RESON accordé (worklet, comb) + crush
perc:   ca(30,16) | sample perc | gain 0.13 | reson 330 0.4 | crush 6 | pan -0.3 | in beat drop melt
# clic morse(n) glitché juste dans le break, sur du verre
morse@break: morse(16) | sample glass | gain 0.16 | delay 0.3 | pan 0.3

# ---------- BASSE ----------
# acid : STACK ; (euclide + ligne tenue) · slide · filtre résonant · fenv · drive · every 4 rev
bass:   e(7,16) ; 1 . . . . . 5, . . . . . 4, . . . | saw | oct 2 | slide | lp 480 q 9 | fenv 0.7 | drive 0.4 | gate 0.4 | every 4 rev | gain 0.15 | hue 0 | in build beat break drop melt outro
# sub sinus = le poids
sub:    1 . . . . . 5, . . . . . 4, . . . | sine | oct 1 | sub 0.5 | env 0.005 0.1 0.3 0.07 | gain 0.32 | in beat drop melt outro

# ---------- MÉLODIE GÉNÉRATIVE ----------
# lead FM : notes ALÉATOIRES {} + ALTERNANCE <5/7> + probabilité ? · jux rev (stéréo) · semi 12 (octave)
lead:   {1 3 5} . <5/7> . {3 5 1'} . 6? . | sine | fm 1 2 | lp 2600 | jux rev | delay 0.34 | reverb 0.4 | gate 0.6 | semi 12 | gain 0.1 | hue 200 | in drop melt
# arpège qui SUIT les accords (^) + arp updown + chunk (motif tournant) + flange (worklet)
arp:    ^ . ^ . ^ . ^ . | arp updown | pluck 0.7 | chunk 4 rev | flange 0.3 | delay 0.25 | reverb 0.3 | gate 0.5 | gain 0.1 | hue 40 | in build break drop melt

# ---------- TEXTURES ----------
# nappe GRANULAIRE + FORMANTS (vowel) microtonale (suit ^) + flange + LFO de filtre
pad:    ^ . . . . . . . . . . . . . . . | saw | unison 4 | grain 0.5 | vowel a | lp 1500 | flange 0.2 | lfo cutoff 0.15 0.5 | reverb 0.7 | gate 1.8 | gain 0.07 | hue 300 | in intro build break drop melt outro
# cloches modales éparses : off (écho décalé doux) + add 2 (tierce) + probabilité (degrade)
bell:   ^1' . . . . . . . . . . . ^3' . . . | bell | off 5 add 2 | reverb 0.6 | delay 0.4 | degrade 30 | gain 0.08 | pan 0.4 | hue 60 | in break drop melt outro
# stab glitché (drop only) : SOUS-SÉQUENCES [] qui subdivisent + redux + crush
stab@drop: . . . . [^ ^] . . . . . . [^ ^ ^] . . . | saw | unison 3 | lp 1900 q 6 | redux 5 | crush 3 | env 0.01 0.08 0.2 0.2 | reverb 0.3 | gain 0.09 | hue 160

# ----------------------------------------------------------------
#  À essayer :
#   • seed: 25, 26… -> nouvelles variations (toujours « justes »)
#   • tune: 19edo / 17edo -> couleur microtonale plus alien
#   • prog: Em C Am B -> toute l'harmonie (^) suit
#   • plein écran + touche N -> change de scène (clifford, lorenz, reaction…)
# ----------------------------------------------------------------
