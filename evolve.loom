# ================================================================
#  LOOM — « EVOLVE » : la musique qui se transforme toute seule.
#   • | mutate N   -> le motif évolue à chaque mesure (jamais pareil)
#   • | stutter N  -> beat-repeat (boucle le début du motif)
#   • | tape N     -> caractère cassette lo-fi (wow + satur. + souffle)
#   • scene: vortex / lattice
#
#  > RUN et laisse tourner longtemps : ça dérive sans se répéter.
#    seed: 4 -> 5 = une autre évolution (toujours « musicale »).
# ================================================================

title:  Evolve
bpm:    120
key:    c minor
prog:   auto minor
seed:   4
duck:   30
warmth: 0.4
scene:  vortex
song:   intro*2 main*12 out*2

kick:   x . . . x . . . x . . . x . . . | sample bd | gain 0.5 | in main out
clap:   . . . . x . . . . . . . x . . . | sample cp | gain 0.32 | in main
hat:    x x x x x x x x x x x x x x x x | stutter 4 | sample hh | gain 0.09 | swing 56 | in main out

# basse qui mute lentement
bass:   1 . 5, . 1 . 4, . 1 . 5, . 6, . 5, . | mutate 20 | saw | oct 2 | lp 700 q 6 | drive 0.3 | gate 0.5 | gain 0.14 | in main out

# lead génératif sur la gamme, qui dérive
lead:   1 2 3 5 6 5 3 2 1 7, 1 2 3 5 6 5 | mutate 35 | pluck 0.7 | tape 0.4 | delay 0.3 | reverb 0.4 | gate 0.6 | gain 0.1 | in main

# nappe cassette qui suit la prog
pad:    ^ . . . . . . . . . . . . . . . | wt warm | tape 0.6 | haas 0.5 | lp 1200 | env 0.6 0.4 0.7 2 | reverb 0.6 | gate 1.8 | gain 0.07 | in intro main out

# cloche additive, mode arpège diverge, éclats rares
spark@main: ^ . . . . . . . | partials 1 0.5 0.7 0.3 0.5 | arp diverge | reverb 0.6 | delay 0.4 | degrade 30 | gain 0.06 | pan 0.3

# ----------------------------------------------------------------
#  Essaie : mutate 50 (chaos) · scene: lattice · prog: auto epic.
# ----------------------------------------------------------------
