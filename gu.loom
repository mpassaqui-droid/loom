# ================================================================
#  LOOM — « 古 GǓ » (Antiguo) : China antigua + voces tribales.
#  Escala pentatónica (gong), afinación justa, gongs/campanas modales,
#  guzheng (cuerda pulsada), dizi (flauta), erhu (cuerda frotada),
#  y COROS TRIBALES (formantes + vocoder, en quintas paralelas/organum).
#  Forma larga: amanecer -> llamada -> marcha -> canto -> danza -> tormenta -> final.
# ================================================================

title:  Gu
bpm:    76
key:    d pentatonic        # gong (宫) : 1=Re 2=Mi 3=Fa# 5=La 6=Si
tune:   just
feel:   30
warmth: 0.45
scene:  mandala
film:   square
song:   dawn*4 call*4 march*6 chant*6 dance*8 storm*6 fade*4

# ---------- BORDÓN (qin/sheng) : Sa + Pa sostenidos, de principio a fin ----------
drone:  1 . . . . . . . . . . . . . . . ; 5, . . . . . . . . . . . . . . . | bow | unison 2 | lp 1200 | ir hall 0.4 | reverb 0.7 | gate 4 | gain 0.07 | hue 30
sub:    1 . . . . . . . . . . . . . . . | sine | oct 1 | sub 0.5 | env 1.5 1 0.9 3 | gain 0.16 | hue 220 | in march dance storm fade

# ---------- TEMA (el hilo conductor) : el MISMO motivo en TODAS las secciones ----------
# Sin @section ni | in -> suena en toda la pieza, siempre igual: es lo reconocible.
tema:   1 . . 5, . . 1 . 2 . 3 . 5 . 3 2 | sine | fm 1 1.5 | slide | lp 2400 | reverb 0.55 | delay 0.3 | echo 8 0.35 | gate 0.7 | humanize 30 | gain 0.11 | hue 190

# ---------- VOZ CONTINUA : coro de vocales presente de principio a fin ----------
voz:    1 . . . . . . . 5 . . . . . . . | saw | unison 4 | vowel a | harmonize 7 0.4 | lp 1500 | env 0.4 0.3 0.7 2 | reverb 0.85 | humanize 55 | gate 2 | gain 0.07 | hue 300

# ---------- DIZI (flauta de bambú) : la melodía principal, con meend ----------
dizi@dawn:  1 . 2 1 . 6, 1 . 2 3 . 2 1 . . . | reed | slide | lp 2200 | reverb 0.6 | delay 0.3 | echo 6 0.4 | humanize 45 | gate 0.9 | gain 0.12 | hue 150
dizi@call:  3 . 5 3 . 2 1 . 5 . 6 5 3 2 1 . | reed | slide | lp 2400 | reverb 0.6 | delay 0.25 | humanize 40 | gate 0.8 | gain 0.13 | hue 150
dizi@chant: . . 1' . 6 . 5 . . . 3 . 5 . 6 . | reed | slide | lp 2300 | reverb 0.6 | echo 4 0.45 | gate 0.8 | gain 0.12 | hue 150
dizi@dance: 1 2 3 5 6 5 3 2 1 5, 1 2 3 5 6 1' | reed | slide | lp 2600 | reverb 0.5 | delay 0.2 | gate 0.6 | gain 0.13 | hue 150
dizi@storm: 5 6 1' 6 5 3 5 6 1' 3' 1' 6 5 3 2 1 | reed | slide | lp 2800 | drive 0.2 | reverb 0.5 | gate 0.6 | gain 0.13 | hue 150

# ---------- GUZHENG (cítara pulsada) : arpegios y glissandi ----------
zheng@call:  1 2 3 5 6 5 3 2 1 6, 5, 3, 5, 1 2 3 | pluck 0.75 | strum 0.01 | delay 0.3 | reverb 0.5 | gate 0.6 | gain 0.1 | pan -0.25 | hue 40
zheng@chant: 1 . 3 . 5 . 6 . 1' . 6 . 5 . 3 . | pluck 0.7 | delay 0.35 | reverb 0.5 | gate 0.6 | gain 0.1 | pan -0.25 | hue 40
zheng@dance: 1 3 5 6 1' 6 5 3 1 3 5 6 1' 3' 1' 6 | pluck 0.78 | strum 0.005 | autopan 0.3 | delay 0.2 | reverb 0.4 | gate 0.5 | gain 0.1 | hue 40
zheng@storm: 1*2 5 1' 6*2 5 3 5*2 6 1' 5 3*2 2 1 . | pluck 0.8 | delay 0.2 | reverb 0.4 | gate 0.5 | gain 0.1 | pan 0.2 | hue 40

# ---------- ERHU (cuerda frotada) : voz expresiva, lamentosa ----------
erhu@chant:  5 . . 6 . 5 . 3 . . 2 . 1 . . . | bow | unison 2 | slide | lp 2000 | lfo pitch 5 0.15 | reverb 0.7 | echo 6 0.3 | humanize 50 | gate 1.4 | gain 0.09 | hue 280
erhu@storm:  1' . 6 5 . 6 1' . 6 . 5 3 . 2 . 1 | bow | unison 2 | slide | lp 2200 | reverb 0.6 | gate 1 | gain 0.1 | hue 280

# ---------- CAMPANAS / GONG (síntesis modal) : colotomía ----------
gong:   1 . . . . . . . . . . . . . . . | bell | oct 1 | detune 4 | reverb 0.8 | gate 4 | gain 0.13 | hue 60 | in call march chant dance storm fade
bells@chant: 1' . . . 5 . . . 6 . . . 3 . . . | bell | detune 5 | reverb 0.7 | delay 0.4 | degrade 25 | gain 0.07 | pan 0.35 | hue 60
bells@dance: 1' . 5 . 6 . 3 . 5 . 1' . 6 . 5 . | bell | detune 5 | reverb 0.6 | delay 0.3 | gain 0.06 | pan 0.35 | hue 60

# ---------- VOCES TRIBALES : coros de formantes en quintas (organum) ----------
# coro base, presente en casi todas las secciones (las voces nunca desaparecen)
coro:   1 . . . 5 . . . 6 . . . 5 . . . | saw | unison 4 | vowel a | harmonize 7 0.4 | lp 1500 | env 0.2 0.3 0.7 1.4 | reverb 0.8 | humanize 50 | gate 1.6 | gain 0.07 | hue 300 | in dawn call march dance fade
coro2:  . . 5 . . . 1' . . . 6 . . . 5 . | saw | unison 3 | vowel o | harmonize 12 0.3 | reverb 0.8 | delay 0.3 | humanize 50 | gate 1.4 | gain 0.05 | pan 0.3 | hue 320 | in call march dance fade
choir@chant: 1 . . . 5 . . . 6 . . . 5 . . . | saw | unison 5 | vowel a | harmonize 7 0.45 | lp 1700 | env 0.1 0.3 0.7 1.2 | reverb 0.85 | ir hall 0.4 | humanize 55 | gate 1.8 | gain 0.1 | hue 300
voce@chant:  . . 1' . . . 6 . . . 5 . . . 3 . | saw | unison 3 | vowel o | harmonize 12 0.35 | reverb 0.8 | delay 0.3 | humanize 55 | gate 1.4 | gain 0.08 | pan -0.3 | hue 320
tribe@dance: 1 . 3 . 5 . 1' . 6 . 5 . 3 . 1 . | saw | unison 3 | vocode vox | lp 2000 | reverb 0.6 | humanize 45 | gate 0.5 | gain 0.08 | hue 180
chant@storm: 1 1 5 5 6 6 1' 1' | saw | unison 4 | vowel a | harmonize 7 0.5 | tgate 8 | lp 1700 | drive 0.2 | reverb 0.7 | gain 0.08 | hue 340
breath@dawn: 1 . . . . . . . | sine | noise 0.5 | hp 900 | reverb 0.6 | gate 2 | gain 0.04 | in dawn fade

# ---------- TAMBORES (taiko) : marcha y danza ----------
taiko@march: x . . x . . x . x . . x . . x . | sample bd | gain 0.5 | comp 0.4
tomm@march:  . . x . . . x . . . x . . x . . | sample tom | gain 0.3 | pan 0.3
taiko@dance: x . x . x . x . x . x . x . x . | sample bd | gain 0.5 | comp 0.4
clap@dance:  . . . . x . . . . . . . x . . . | sample cp | gain 0.3
perc@dance:  . x . x . . x . . x . x . . x . | sample perc | gain 0.2 | pan -0.3
taiko@storm: x . x x . x x . x . x x . x x . | sample bd | drive 0.2 | gain 0.55 | comp 0.5
tomm@storm:  . . x . x . . x . x . . x . x . | sample tom | gain 0.32 | pan 0.25

